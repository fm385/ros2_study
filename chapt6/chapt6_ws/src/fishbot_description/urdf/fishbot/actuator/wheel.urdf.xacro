<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/fishbot/common_inertia.xacro" />

    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- wheel -->
        <link name="${wheel_name}_wheel_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder length="0.04" radius="0.032" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0" />
                <geometry>
                    <cylinder length="0.04" radius="0.032" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </collision>
            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04" />
        </link>

        <gazebo reference="${wheel_name}_wheel_link">
            <visual>
                <material>
                    <diffuse>1 0 0 1</diffuse>
                    <ambient>1 0 0 1</ambient>
                    <specular>0.9 0.1 0.1 1</specular>
                </material>
            </visual>
            <!-- 物理属性统一放入 collision 标签内 -->
            <collision>
                <surface>
                <!-- 1. 摩擦参数：mu1 -> mu, mu2 -> mu2 -->
                <friction>
                    <ode>
                    <mu>20.0</mu>    <!-- 原 mu1 的值 -->
                    <mu2>20.0</mu2>  <!-- 原 mu2 的值 -->
                    <!-- 如果轮子有明确的主摩擦方向，建议加上 fdir1 -->
                    <!-- <fdir1>0 1 0</fdir1> -->
                    </ode>
                </friction>

                <!-- 2. 接触参数：kp, kd 移入 contact/ode -->
                <contact>
                    <ode>
                    <kp>1000000000.0</kp>  <!-- 原 kp 的值 -->
                    <kd>1.0</kd>           <!-- 原 kd 的值 -->
                    </ode>
                </contact>
                </surface>
            </collision>
        </gazebo>

        <!-- joint -->
        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link" />
            <child link="${wheel_name}_wheel_link" />
            <origin xyz="${xyz}"  />
            <axis xyz="0 1 0" />
        </joint>
    </xacro:macro>
</robot>