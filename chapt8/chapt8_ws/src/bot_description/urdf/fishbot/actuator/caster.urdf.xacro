<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find bot_description)/urdf/fishbot/common_inertia.xacro" />

    <xacro:macro name="caster_xacro" params="caster_name xyz">
        <!-- caster -->
        <link name="${caster_name}_caster_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <sphere radius="0.016" />
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0.0 0.8" />
                </material>
            </collision>
            <xacro:sphere_inertia m="0.05" r="0.016" />
        </link>

        <gazebo reference="${caster_name}_caster_link">
            <visual>
                <material>
                    <diffuse>0 1 0 1</diffuse>
                    <ambient>0 1 0 1</ambient>
                    <specular>0.1 0.9 0.1 1</specular>
                </material>
            </visual>
            <!-- 物理属性统一放入 collision 标签内 -->
            <collision>
                <surface>
                <!-- 1. 摩擦参数：mu1 -> mu, mu2 -> mu2 -->
                <friction>
                    <ode>
                    <mu>0.0</mu>    <!-- 原 mu1 的值 -->
                    <mu2>0.0</mu2>  <!-- 原 mu2 的值 -->
                    <!-- 如果轮子有明确的主摩擦方向，建议加上 fdir1 -->
                    <!-- <fdir1>0 1 0</fdir1> -->
                    </ode>
                </friction>

                <!-- 2. 接触参数：kp, kd 移入 contact/ode -->
                <contact>
                    <ode>
                    <kp>1000000000.0</kp>  <!-- 原 kp 的值 -->
                    <kd>1.0</kd>           <!-- 原 kd 的值 -->
                    </ode>
                </contact>
                </surface>
            </collision>
        </gazebo>

        <!-- joint -->
        <joint name="${caster_name}_caster_joint" type="fixed">
            <parent link="base_link" />
            <child link="${caster_name}_caster_link" />
            <origin xyz="${xyz}"  />
            <axis xyz="0 0 0" />
        </joint>
    </xacro:macro>
</robot>